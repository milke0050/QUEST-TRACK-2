rules_version = '2';

// 기본: 읽기는 누구나, 쓰기는 로그인한 사람만, 지우기는 자기 것만.
// 나만 봐야 하는 기록(games)은 읽기도 나만 된다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사람 칸: 번호(uid)와 별명. 별명은 누구나 볼 수 있다.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 내 판 상태: 나만 읽고, 나만 쓰고, 나만 지운다.
    match /games/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'stateJson', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() < 200000;
    }

    // 나머지는 모두 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
