rules_version = '2';

// 기본: 읽기는 로그인한 사람이면 누구나, 쓰기는 로그인한 사람만, 지우기는 자기 것만.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사람 칸: 번호(uid), 별명, 지금 들어가 있는 방 코드. 별명은 누구나 볼 수 있다.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'createdAt', 'roomCode'])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 방: 로그인한 사람이면 코드로 찾아 읽을 수 있다. 만들고 고치고 지우는 건 방장만.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.keys().hasOnly(['code', 'hostUid', 'hostName', 'name', 'status', 'stateJson', 'updatedAt']);
      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.keys().hasOnly(['code', 'hostUid', 'hostName', 'name', 'status', 'stateJson', 'updatedAt'])
        && (request.resource.data.stateJson == null || request.resource.data.stateJson.size() < 500000);
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // 방에 들어온 사람: 자기 칸만 쓰고, 시작 전(lobby)에만 들어올 수 있다. 방장은 지울 수 있다.
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'lobby'
          && request.resource.data.keys().hasOnly(['uid', 'nickname', 'role', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.role in ['company', 'investor'];
        allow delete: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid);
      }

      // 행동: 방에 들어온 사람이 보내고, 읽고 지우는 건 방장만.
      match /actions/{id} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['uid', 'type', 'i', 'product', 'price', 'c', 'turn', 'phase', 'createdAt'])
          && request.resource.data.type is string;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
      }
    }

    // 나머지는 모두 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
